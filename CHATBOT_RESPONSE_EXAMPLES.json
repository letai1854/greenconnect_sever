    "7_error_session_not_found": {
      "description": "Error: Session không tồn tại",
      "request": {
        "method": "GET",
        "url": "/api/chat/sessions/invalid-uuid?userId=123e4567-e89b-12d3-a456-426614174000&page=0&size=10"
      },
      "response": {
        "status": 404,
        "body": {
          "code": "CHAT_SESSION_NOT_FOUND",
          "message": "Session không tồn tại hoặc đã bị xóa"
        }
      }
    },
