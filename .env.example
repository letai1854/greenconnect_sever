# ========================================
# 🔒 TEMPLATE .ENV FILE - COPY VÀ ĐIỀN THÔNG TIN
# ========================================
# 📋 HƯỚNG DẪN CHO TEAM MEMBERS:
# 1. Copy file này thành ".env" 
# 2. Điền thông tin thực tế vào các trường trống
# 3. TUYỆT ĐỐI KHÔNG commit .env lên Git!

# ========================================
# 🗄️ DATABASE CONFIGURATION
# ========================================
# 🔗 Aiven Console: https://console.aiven.io/
# Lấy connection string từ Aiven MySQL service
DB_URL=                            # VD: jdbc:mysql://yourdb.aivencloud.com:23411/defaultdb?ssl-mode=REQUIRED&serverTimezone=Asia/Ho_Chi_Minh
DB_USERNAME=                       # VD: avnadmin
DB_PASSWORD=                       # VD: AVNS_xxxxxx (từ Aiven dashboard)

# ========================================
# 🏢 VNPAY CONFIGURATION - CẦN ĐĂNG KÝ TẠI VNPAY.VN
# ========================================
# 🔗 Link đăng ký: https://vnpay.vn/dang-ky-merchant
# 📧 Cần: Giấy phép kinh doanh + CMND/CCCD + Tài khoản ngân hàng doanh nghiệp

# Merchant Info từ VNPay Dashboard
VNPAY_TMN_CODE=                    # VD: VNPAY12345678 (8-10 ký tự)
VNPAY_HASH_SECRET=                 # VD: ABCXYZ123456789... (32+ ký tự)

# URLs cho callback (thay đổi theo environment)
# DEVELOPMENT:
VNPAY_RETURN_URL=http://localhost:3000/payment-result
VNPAY_CALLBACK_URL=http://localhost:8080/orders/vnpay-callback

# PRODUCTION (uncomment và update khi deploy):
# VNPAY_RETURN_URL=https://yourapp.com/payment-result  
# VNPAY_CALLBACK_URL=https://api.yourapp.com/orders/vnpay-callback

# ========================================
# � JWT CONFIGURATION
# ========================================
# 🔑 Tạo key mới cho production: https://generate-random.org/encryption-key-generator
JWT_SIGNER_KEY=                    # VD: m9IKp5ekdg0XdZQ9bm8uZoT... (64+ ký tự)

# ========================================
# 🔥 FIREBASE CONFIGURATION
# ========================================
# 🔗 Console: https://console.firebase.google.com/
# 📁 Cần tạo project và enable Storage
FIREBASE_BUCKET_NAME=              # VD: yourproject.appspot.com

# ========================================
# 🗺️ GOOGLE MAPS CONFIGURATION  
# ========================================
# 🔗 Console: https://console.cloud.google.com/apis/
# 🔑 Enable: Maps JavaScript API, Geocoding API, Places API
GOOGLE_MAPS_API_KEY=               # VD: AIzaSyD...

# ========================================
# � DATABASE CONFIGURATION (Optional - nếu muốn override)
# ========================================
# DB_URL=
# DB_USERNAME=
# DB_PASSWORD=

# ========================================
# 📝 DEVELOPMENT NOTES:
# ========================================
# 🔧 Local Development: Chỉ cần điền VNPAY_* để test thanh toán
# 🚀 Production Ready: Cần điền tất cả các trường
# 🛡️ Security: Thay đổi JWT_SIGNER_KEY cho từng environment
# 📞 Support: Contact team lead nếu cần thông tin production