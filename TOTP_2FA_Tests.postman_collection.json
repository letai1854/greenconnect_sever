{
  "info": {
    "name": "TOTP 2FA Authentication Tests",
    "description": "Test collection for TOTP 2FA login flow",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Login - First Time (Get QR Code)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/admin/login",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["admin", "login"]
        },
        "description": "First time login - should return QR code if 2FA not activated"
      },
      "response": []
    },
    {
      "name": "2. Google Login - First Time (Get QR Code)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"test@gmail.com\",\n  \"providerId\": \"google-uid-12345\",\n  \"fullName\": \"Test User\",\n  \"photoURL\": \"https://example.com/photo.jpg\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/admin/google-login",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["admin", "google-login"]
        },
        "description": "Google login - should return QR code if 2FA not activated"
      },
      "response": []
    },
    {
      "name": "3. Verify OTP - Correct Code",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"otpCode\": \"123456\",\n  \"deviceInfo\": \"iPhone 13 Pro/iOS 17.0\",\n  \"fcmToken\": \"firebase-token-here\",\n  \"deviceType\": \"IOS\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/admin/verify-otp",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["admin", "verify-otp"]
        },
        "description": "Verify OTP with correct code - should return access token and refresh token"
      },
      "response": []
    },
    {
      "name": "4. Verify OTP - Incorrect Code (Error 4890)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"otpCode\": \"999999\",\n  \"deviceInfo\": \"iPhone 13 Pro/iOS 17.0\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/admin/verify-otp",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["admin", "verify-otp"]
        },
        "description": "Verify OTP with incorrect code - should return error 4890"
      },
      "response": []
    },
    {
      "name": "5. Login - Already Activated 2FA",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/admin/login",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["admin", "login"]
        },
        "description": "Login when 2FA already activated - should ask for OTP without QR code"
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "userId",
      "value": "paste-user-id-here",
      "type": "string"
    }
  ]
}
